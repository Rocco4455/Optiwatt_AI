<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="NunitoText">
        <item name="android:fontFamily">@font/nunito_regular</item>
        <item name="android:textColor">#333333</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="NunitoBoldText">
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textColor">#385167</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/menu_sfondo</item>
        <item name="android:textAppearance">@style/NunitoBoldText</item>
    </style>


</resources>


