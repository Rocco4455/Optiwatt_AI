<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#ededed">

    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="344dp"
        android:layout_height="115dp"
        android:layout_marginTop="32dp"
        android:adjustViewBounds="true"
        android:contentDescription="Optiwatt AI Logo"
        android:scaleType="fitCenter"
        android:src="@drawable/logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.473"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/IMG_watt"
        android:layout_width="401dp"
        android:layout_height="250dp"
        android:layout_marginTop="50dp"
        android:adjustViewBounds="true"
        android:contentDescription="Smart Home Illustration"
        android:scaleType="fitCenter"
        android:src="@drawable/home"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logoImage" />

    <TextView
        android:id="@+id/text2"
        style="@style/NunitoBoldText"
        android:layout_width="225dp"
        android:layout_height="64dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="16dp"
        android:text="Or link your energy premest"
        android:textSize="24sp"
        app:layout_constraintStart_toEndOf="@id/ball2"
        app:layout_constraintTop_toBottomOf="@id/text1" />

    <ImageView
        android:id="@+id/ball3"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="240dp"
        android:src="@drawable/ball"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/IMG_watt" />

    <TextView
        android:id="@+id/text3"
        style="@style/NunitoBoldText"
        android:layout_width="224dp"
        android:layout_height="71dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:text="See how much you can save"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.05"
        app:layout_constraintStart_toEndOf="@id/ball3"
        app:layout_constraintTop_toBottomOf="@id/text2" />

    <ImageView
        android:id="@+id/ball1"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="80dp"
        android:src="@drawable/ball"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/IMG_watt" />

    <TextView
        android:id="@+id/text1"
        style="@style/NunitoBoldText"
        android:layout_width="224dp"
        android:layout_height="64dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="60dp"
        android:text="Connect your smart devices"
        android:textSize="24sp"
        app:layout_constraintStart_toEndOf="@id/ball1"
        app:layout_constraintTop_toBottomOf="@id/IMG_watt" />

    <ImageView
        android:id="@+id/ball2"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="160dp"
        android:src="@drawable/ball"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/IMG_watt" />

    <Button
        android:id="@+id/Bottone_Start"
        android:layout_width="323dp"
        android:layout_height="55dp"
        android:layout_marginTop="330dp"
        android:layout_marginBottom="25dp"
        android:backgroundTint="#86B1A4"
        android:padding="12dp"
        android:text="Get Started"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/IMG_watt"
        app:layout_constraintVertical_bias="0.125" />

</androidx.constraintlayout.widget.ConstraintLayout>